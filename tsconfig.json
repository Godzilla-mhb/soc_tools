{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "strict": true,
    "jsx": "preserve",
    "allowJs": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "lib": ["es2020", "dom",
           "dom.iterable",
          "scripthost"]
  },
  "include": [
  "src/**/*",
  "src/**/*.ts",
  "src/**/*.tsx",
  "src/**/*.vue",
  "./src/**/*.vue", 
  "tests/**/*.ts",
  "tests/**/*.tsx"
],
}
